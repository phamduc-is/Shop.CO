{% doc %}
  Hero CTA button — theme block, tách ra từ local block "button" của section hero.
  Style dùng class `.hero-btn` / `.hero-btn--{style}` trong assets/theme.css.

  @example
  {% content_for 'block', type: 'hero-button', id: 'hero-cta' %}
{% enddoc %}

{% if block.settings.label != blank %}
  <a
    href="{{ block.settings.url | default: '#' }}"
    class="btn hero-btn hero-btn--{{ block.settings.style | default: 'primary' }}"
    {% if block.settings.color != blank %}
      style="color: {{ block.settings.color }};"
    {% endif %}
    {{ block.shopify_attributes }}
  >
    {{ block.settings.label }}
  </a>
{% endif %}

{% schema %}
{
  "name": "t:blocks.hero-button.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:blocks.hero-button.settings.label.label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "url",
      "label": "t:blocks.hero-button.settings.url.label"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:blocks.hero-button.settings.style.label",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        }
      ],
      "default": "primary"
    },
    {
      "type": "color",
      "id": "color",
      "label": "t:blocks.hero-button.settings.color.label"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.hero-button.presets.1.name",
      "category": "t:blocks.hero-button.presets.1.category"
    }
  ]
}
{% endschema %}
