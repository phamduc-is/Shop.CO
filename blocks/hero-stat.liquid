{% doc %}
  Một ô số liệu trong hero. Chỉ dùng bên trong block `hero-stats`
  (section hero không khai type này ở cấp gốc).

  @example
  {% content_for 'block', type: 'hero-stat', id: 'stat-brands' %}
{% enddoc %}

<div
  class="hero__stat"
  {% if block.settings.color != blank %}
    style="color: {{ block.settings.color }};"
  {% endif %}
  {{ block.shopify_attributes }}
>
  <div class="stat__content">
    <span class="hero__stat-value">{{ block.settings.value }}</span>
    <span class="hero__stat-label text-muted">{{ block.settings.label }}</span>
  </div>
</div>

{% schema %}
{
  "name": "t:blocks.hero-stat.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "value",
      "label": "t:blocks.hero-stat.settings.value.label",
      "default": "200+"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:blocks.hero-stat.settings.label.label",
      "default": "International Brands"
    },
    {
      "type": "color",
      "id": "color",
      "label": "t:blocks.hero-stat.settings.color.label"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.hero-stat.presets.1.name",
      "category": "t:blocks.hero-stat.presets.1.category"
    }
  ]
}
{% endschema %}
