{% doc %}
  Hero description — theme block, tách ra từ local block "text" của section hero.
  Style dùng class `.hero-text` trong assets/theme.css.

  @example
  {% content_for 'block', type: 'hero-text', id: 'hero-text' %}
{% enddoc %}

<div
  class="hero-text text-muted"
  {% if block.settings.color != blank %}
    style="color: {{ block.settings.color }};"
  {% endif %}
  {{ block.shopify_attributes }}
>
  {{ block.settings.text }}
</div>

{% schema %}
{
  "name": "t:blocks.hero-text.name",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:blocks.hero-text.settings.text.label",
      "default": "<p>text</p>"
    },
    {
      "type": "color",
      "id": "color",
      "label": "t:blocks.hero-text.settings.color.label"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.hero-text.presets.1.name",
      "category": "t:blocks.hero-text.presets.1.category"
    }
  ]
}
{% endschema %}
