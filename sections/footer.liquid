{% if section.settings.show_newsletter %}
  <div class="footer_newsletter">
    <h2>{{ section.settings.newsletter_heading }}</h2>
    {% comment %} Tam thoi de trong {% endcomment %}
  </div>
{% endif %}
<div class="footer__top footer-grid">
  <div class="footer__brands">
    {{ section.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', class: 'footer__logo' }}
    <p>{{ section.settings.desc }}</p>
    <ul>
      <li>
        <a href="{{ section.settings.social_twitter_url  }}"> </a>
      </li>
      <li>
        <a href="{{ section.settings.social_facebook_url }}">  </a>
      </li>
      <li>
        <a href="{{ section.settings.social_instagram_url }}">  </a>
      </li>
      <li>
        <a href="{{ section.settings.social_github_url }}">  </a>
      </li>
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "container",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Stay upto date about our latest offers"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "textarea",
      "id": "desc",
      "label": "Description"
    },
    {
      "type": "url",
      "id": "social_twitter_url",
      "label": "Social twitter url"
    },
    {
      "type": "url",
      "id": "social_facebook_url",
      "label": "Social facebook url"
    },
    {
      "type": "url",
      "id": "social_instagram_url",
      "label": "Social instagram url"
    },
    {
      "type": "url",
      "id": "social_github_url",
      "label": "Social github url"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright content",
      "default": "Shop.co © 2000-2023, All Rights Reserved"
    }
  ],
  "max_blocks": 4,
  "blocks": [{ "type": "_footer-menu" }],
  "presets": [
    {
      "name": "Footer1",
      "blocks": [
        { "type": "_footer-menu" },
        { "type": "_footer-menu" },
        { "type": "_footer-menu" },
        { "type": "_footer-menu" }
      ]
    }
  ]
}
{% endschema %}
