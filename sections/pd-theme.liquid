{% # Sandbox section dùng THEME BLOCK — markup của block nằm ở blocks/pd-card.liquid %}

{{ 'pd-sandbox.css' | asset_url | stylesheet_tag }}

<section class="pd-sandbox pd-sandbox--theme container">
  <header class="pd-sandbox__head">
    <span class="pd-badge pd-badge--theme">THEME BLOCK</span>
    <h2 class="pd-sandbox__title">{{ section.settings.heading }}</h2>
    <p class="pd-sandbox__meta">
      section: <code>pd-theme</code> · render: <code>{% raw %}{% content_for 'blocks' %}{% endraw %}</code> · product:
      <strong>{{ product.title | default: 'no product in context' }}</strong>
    </p>
  </header>

  <ul class="pd-grid" role="list">
    {% content_for 'blocks' %}
  </ul>
</section>

{% schema %}
{
  "name": "t:sections.pd-theme.name",
  "tag": "section",
  "class": "section-pd-theme",
  "limit": 2,
  "settings": [
    {
      "type": "header",
      "content": "t:sections.pd-theme.settings.header__1.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.pd-theme.settings.heading.label",
      "default": "Theme block sandbox"
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "t:sections.pd-theme.presets.1.name",
      "blocks": [
        {
          "type": "pd-card",
          "settings": {}
        },
        {
          "type": "pd-card",
          "settings": {
            "title": "Theme B"
          }
        },
        {
          "type": "pd-card",
          "settings": {
            "title": "ThemeCCCCsCC"
          }
        }
      ]
    }
  ]
}
{% endschema %}
