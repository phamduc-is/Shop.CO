{% # Blocks của section này là THEME BLOCK: markup nằm ở blocks/hero-*.liquid %}

<section class="hero container">
  <div class="hero__media">
    <picture>
      {% if section.settings.image_mobile != blank %}
        <source media="(max-width: 989px)" srcset="{{ section.settings.image_mobile | image_url: width: 750 }}">
      {% endif %}
      <img
        src="{{ section.settings.image | image_url: width: 1440 }}"
        alt="{{ section.settings.image.alt | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="eager"
      >
    </picture>
  </div>

  <div class="hero__content hero__content--desktop-{{ section.settings.content_position }} hero__content--mobile-{{ section.settings.content_position_mobile }}">
    <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {% content_for 'blocks' %}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image" },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "center-left", "label": "Center left" },
        { "value": "center-center", "label": "Center" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" }
      ],
      "default": "center-left"
    },
    {
      "type": "select",
      "id": "content_position_mobile",
      "label": "Content position (Mobile)",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "center-left", "label": "Center left" },
        { "value": "center-center", "label": "Center" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" }
      ],
      "default": "top-center"
    }
  ],
  "blocks": [
    { "type": "hero-text" },
    { "type": "hero-button" },
    { "type": "hero-stats" }
  ],
  
  "presets": [
    {
      "name": "Hero 2",
      "blocks": [
        { "type": "hero-text" },
        { "type": "hero-button" },
        {
          "type": "hero-stats",
          "blocks": [
            { "type": "hero-stat", "settings": { "value": "200+", "label": "International Brands" } },
            { "type": "hero-stat", "settings": { "value": "2,000+", "label": "High-Quality Products" } },
            { "type": "hero-stat", "settings": { "value": "30,000+", "label": "Happy Customers" } }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
