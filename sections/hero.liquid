<section class="hero container">
  <div class="hero__media">
    <picture>
      {% if section.settings.image_mobile != blank %}
        <source media="(max-width: 989px)" srcset="{{ section.settings.image_mobile | image_url: width: 750 }}">
      {% endif %}
      <img
        src="{{ section.settings.image | image_url: width: 1440 }}"
        alt="{{ section.settings.image.alt | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="eager"
      >
    </picture>
  </div>

  <div class="hero__content hero__content--desktop-{{ section.settings.content_position }} hero__content--mobile-{{ section.settings.content_position_mobile }}">
    <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'text' %}
          <div
            class="hero-text text-muted"
            style="{% if block.settings.color != blank %} color: {{ block.settings.color }};{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.text }}
          </div>
        {% when 'button' %}
          {% if block.settings.label != blank %}
            <a
              href="{{ block.settings.url | default: '#' }}"
              class="hero-btn hero-btn--{{ block.settings.style | default: 'primary' }}"
              {% if block.settings.color != blank %}
                style="color: {{ block.settings.color }};"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label }}
            </a>
          {% endif %}
      {% endcase %}
    {% endfor %}

    {% comment %} stat gom riêng ra ngoài {% endcomment %}
    <div class="hero__stats">
      {% for block in section.blocks %}
        {% if block.type == 'stat' %}
          <div
            class="hero__stat"
            {% if block.settings.color != blank %}
              style="color: {{ block.settings.color }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <div class="stat__content">
              <span class="hero__stat-value">{{ block.settings.value }}</span>
              <span class="hero__stat-label text-muted">{{ block.settings.label }}</span>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image" },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "center-left", "label": "Center left" },
        { "value": "center-center", "label": "Center" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" }
      ],
      "default": "center-left"
    },
    {
      "type": "select",
      "id": "content_position_mobile",
      "label": "Content position (Mobile)",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "center-left", "label": "Center left" },
        { "value": "center-center", "label": "Center" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" }
      ],
      "default": "top-center"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Description",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "color", "id": "color", "label": "Text color" }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop Now" },
        { "type": "url", "id": "url", "label": "Link" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "primary", "label": "Primary" },
            { "value": "secondary", "label": "Secondary" }
          ],
          "default": "primary"
        },
        { "type": "color", "id": "color", "label": "Text color" }
      ]
    },
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "200+" },
        { "type": "text", "id": "label", "label": "Label", "default": "International Brands" },
        { "type": "color", "id": "color", "label": "Value color" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "text" },
        { "type": "button" },
        { "type": "stat", "settings": { "value": "200+", "label": "International Brands" } },
        { "type": "stat", "settings": { "value": "2,000+", "label": "High-Quality Products" } },
        { "type": "stat", "settings": { "value": "30,000+", "label": "Happy Customers" } }
      ]
    }
  ]
}
{% endschema %}
