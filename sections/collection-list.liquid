<div class="collection-list">
  <h2 class="collection-list__heading">{{ section.settings.heading }}</h2>

  <ul class="collection-list__grid collection-list__grid--{{ section.settings.layout }}" role="list">
    {% content_for 'blocks' %}
  </ul>
</div>
{% schema %}
{
  "name": "t:sections.collection-list.name",
  "tag": "section",
  "class": "container",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.collection-list.settings.heading.label",
      "default": "BROWSE BY DRESS STYLE"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.collection-list.settings.layout.label",
      "options": [
        {
          "value": "equal",
          "label": "Equal — 2 per row, same size"
        },
        {
          "value": "contrast",
          "label": "Contrast — narrow / wide alternating"
        }
      ],
      "default": "contrast"
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "collection-card"
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection-list.presets.1.name",
      "category": "t:sections.collection-list.presets.1.category",
      "blocks": [
        {
          "type": "collection-card"
        },
        {
          "type": "collection-card"
        },
        {
          "type": "collection-card"
        },
        {
          "type": "collection-card"
        }
      ]
    },
    {
      "name": "t:sections.collection-list.presets.2.name",
      "blocks": [
        {
          "type": "collection-card"
        },
        {
          "type": "collection-card"
        },
        {
          "type": "collection-card"
        }
      ]
    }
  ]
}
{% endschema %}
